<module name="gamecore">
    <enum name="EntityTarget">
        <var name="All" value="0"/>
        <var name="Player" value="1"/>
        <var name="Monster" value="2"/>
        <var name="Object" value="3"/>
    </enum>

    <enum name="Direction">
        <var name="None" value="0"/>
        <var name="Left" value="1"/>
        <var name="Right" value="2"/>
        <var name="Up" value="3"/>
        <var name="Down" value="4"/>
    </enum>

    <enum name="EffectDurationPolicy">
        <var name="Instant" value="1"/>
        <var name="TimedTicks" value="2"/>
        <var name="InfiniteUntilRemove" value="3"/>
    </enum>

    <enum name="EffectStackPolicy">
        <var name="ReplaceByStackKey" value="1"/>
        <var name="RefreshDuration" value="2"/>
        <var name="AllowMultiple" value="3"/>
        <var name="RejectDuplicate" value="4"/>
    </enum>

    <enum name="EffectRemovePolicy">
        <var name="ExplicitOrExpire" value="1"/>
        <var name="ExplicitOnly" value="2"/>
    </enum>

    <enum name="EffectTargetBinding">
        <var name="TargetEntity" value="1"/>
        <var name="TargetCell" value="2"/>
        <var name="TargetBody" value="3"/>
    </enum>

    <enum name="ActionSourceKind">
        <var name="Player" value="1"/>
        <var name="Auto" value="2"/>
        <var name="Mechanism" value="3"/>
        <var name="Debug" value="4"/>
        <var name="Runtime" value="5"/>
        <var name="Handoff" value="6"/>
    </enum>

    <enum name="ActionPriority">
        <var name="Debug" value="1"/>
        <var name="Player" value="2"/>
        <var name="Mechanism" value="3"/>
        <var name="Auto" value="4"/>
    </enum>

    <enum name="ActionPrimitive">
        <var name="Move" value="1"/>
        <var name="Spawn" value="2"/>
        <var name="Remove" value="3"/>
        <var name="SetComponentResult" value="4"/>
        <var name="ApplyRuntimeEffect" value="5"/>
    </enum>

    <enum name="TargetDirectionSource">
        <var name="None" value="0"/>
        <var name="Request" value="1"/>
        <var name="Component" value="2"/>
        <var name="TargetCoord" value="3"/>
    </enum>

    <enum name="TargetOrderingPolicy">
        <var name="None" value="0"/>
        <var name="HitOrderThenCoordThenEntity" value="1"/>
    </enum>

    <enum name="TargetFilterConditionKind">
        <var name="HasComponent" value="1"/>
        <var name="MissingComponent" value="2"/>
        <var name="HasTag" value="3"/>
        <var name="MissingTag" value="4"/>
    </enum>

    <enum name="TargetFilterSubject">
        <var name="Target" value="1"/>
    </enum>

    <enum name="BlockedResultKind">
        <var name="Reject" value="1"/>
        <var name="DeriveAction" value="2"/>
        <var name="Bounce" value="3"/>
        <var name="Noop" value="4"/>
    </enum>

    <enum name="ActionConditionKind">
        <var name="Always" value="1"/>
        <var name="HasTag" value="2"/>
        <var name="MissingTag" value="3"/>
        <var name="HasComponent" value="4"/>
        <var name="MissingComponent" value="5"/>
        <var name="CanMove" value="6"/>
        <var name="CanBePushed" value="7"/>
        <var name="BodyKindIs" value="8"/>
    </enum>

    <enum name="ActionConditionSubject">
        <var name="Source" value="1"/>
        <var name="Blocking" value="2"/>
        <var name="SourceBody" value="3"/>
        <var name="BlockingBody" value="4"/>
    </enum>

    <enum name="ActionHandoffPolicy">
        <var name="None" value="0"/>
        <var name="Configured" value="1"/>
    </enum>

    <enum name="ActionConflictPolicy">
        <var name="None" value="0"/>
        <var name="ExclusiveTargetCell" value="1"/>
    </enum>

    <enum name="ActionInterruptPolicy">
        <var name="None" value="0"/>
        <var name="HigherPriorityInterruptsLower" value="1"/>
    </enum>

    <enum name="ActionMergePolicy">
        <var name="None" value="0"/>
        <var name="SameClaim" value="1"/>
    </enum>

    <enum name="ActionSubjectPolicy">
        <var name="HitEntity" value="1"/>
        <var name="ConnectedBodyIfAny" value="2"/>
    </enum>

    <enum name="ActionPlanRule">
        <var name="None" value="0"/>
        <var name="MoveBody" value="1"/>
        <var name="SpawnEntity" value="2"/>
        <var name="RemoveEntity" value="3"/>
    </enum>

    <enum name="ActionCommitRule">
        <var name="None" value="0"/>
        <var name="SetAutoMoveTick" value="1"/>
        <var name="SetDirectionOnBounce" value="2"/>
    </enum>

    <enum name="AnimationEasing">
        <var name="Linear" value="1"/>
        <var name="EaseOut" value="2"/>
        <var name="EaseInOut" value="3"/>
    </enum>

    <bean name="EntityArchetype">
        <var name="config_id" type="int"/>
        <var name="archetype_id" type="int"/>
        <var name="entity_target" type="EntityTarget"/>
        <var name="component_ids" type="(list#sep=,),string"/>
        <var name="tags" type="(list#sep=,),string"/>
        <var name="default_auto_move_interval_ticks" type="int"/>
    </bean>

    <bean name="WorldSpawn">
        <var name="world_id" type="string"/>
        <var name="entity_id" type="long"/>
        <var name="config_id" type="int"/>
        <var name="x" type="int"/>
        <var name="y" type="int"/>
        <var name="direction" type="Direction"/>
        <var name="auto_move_interval_ticks" type="int"/>
    </bean>

    <bean name="PlayerSpawnRule">
        <var name="rule_id" type="string"/>
        <var name="player_config_id" type="int"/>
        <var name="start_x" type="int"/>
        <var name="start_y" type="int"/>
        <var name="step_x" type="int"/>
        <var name="step_y" type="int"/>
        <var name="max_attempts" type="int"/>
    </bean>

    <bean name="PortConnectorConfig">
        <var name="config_id" type="int"/>
        <var name="ports" type="int"/>
    </bean>

    <bean name="PushOnEnterConfig">
        <var name="config_id" type="int"/>
        <var name="output_spec_id" type="string"/>
        <var name="output_cost_ticks" type="int"/>
    </bean>

    <bean name="ActionCondition">
        <var name="kind" type="ActionConditionKind"/>
        <var name="subject" type="ActionConditionSubject"/>
        <var name="tag" type="string"/>
        <var name="component_kind" type="string"/>
        <var name="body_kind" type="string"/>
    </bean>

    <bean name="TargetFilterCondition">
        <var name="kind" type="TargetFilterConditionKind"/>
        <var name="subject" type="TargetFilterSubject"/>
        <var name="component_kind" type="string"/>
        <var name="tag" type="string"/>
    </bean>

    <bean name="TargetFilterSpec">
        <var name="filter_id" type="string"/>
        <var name="conditions" type="(list),TargetFilterCondition"/>
    </bean>

    <bean name="TargetingSpec">
        <var name="targeting_id" type="string"/>
        <var name="selector_id" type="string"/>
        <var name="direction_source" type="TargetDirectionSource"/>
        <var name="filter_id" type="string"/>
        <var name="ordering_policy" type="TargetOrderingPolicy"/>
        <var name="range" type="int"/>
        <var name="max_targets" type="int"/>
    </bean>

    <bean name="BlockedResultPolicy">
        <var name="policy_id" type="string"/>
    </bean>

    <bean name="BlockedResultBranch">
        <var name="policy_id" type="string"/>
        <var name="order" type="int"/>
        <var name="conditions" type="(list),ActionCondition"/>
        <var name="result_kind" type="BlockedResultKind"/>
        <var name="result_spec_id" type="string"/>
        <var name="subject_policy" type="ActionSubjectPolicy"/>
        <var name="reason" type="string"/>
        <var name="error_code" type="string"/>
        <var name="commit_rules" type="(list#sep=,),ActionCommitRule"/>
    </bean>

    <bean name="ActionSpec">
        <var name="spec_id" type="string"/>
        <var name="primitive" type="ActionPrimitive"/>
        <var name="source" type="ActionSourceKind"/>
        <var name="priority" type="ActionPriority"/>
        <var name="source_tag" type="string"/>
        <var name="ability_tag" type="string"/>
        <var name="required_tags" type="(list#sep=,),string"/>
        <var name="blocked_tags" type="(list#sep=,),string"/>
        <var name="targeting_id" type="string"/>
        <var name="handoff_policy" type="ActionHandoffPolicy"/>
        <var name="blocked_result_policy_id" type="string"/>
        <var name="handoff_spec_id" type="string"/>
        <var name="handoff_subject_policy" type="ActionSubjectPolicy"/>
        <var name="max_chain_depth" type="int"/>
        <var name="conflict_policy" type="ActionConflictPolicy"/>
        <var name="interrupt_policy" type="ActionInterruptPolicy"/>
        <var name="merge_policy" type="ActionMergePolicy"/>
        <var name="subject_policy" type="ActionSubjectPolicy"/>
        <var name="plan_rule" type="ActionPlanRule"/>
        <var name="commit_rules" type="(list#sep=,),ActionCommitRule"/>
        <var name="default_cost_ticks" type="int"/>
    </bean>

    <bean name="EffectSpec">
        <var name="effect_id" type="string"/>
        <var name="effect_payload_id" type="string"/>
        <var name="target_binding" type="EffectTargetBinding"/>
        <var name="duration_policy" type="EffectDurationPolicy"/>
        <var name="stack_policy" type="EffectStackPolicy"/>
        <var name="remove_policy" type="EffectRemovePolicy"/>
        <var name="duration_ticks" type="long"/>
        <var name="auto_move_interval_ticks" type="int"/>
        <var name="port_mask" type="int"/>
        <var name="can_move" type="bool"/>
        <var name="can_be_pushed" type="bool"/>
        <var name="tag" type="string"/>
        <var name="cue_id" type="string"/>
        <var name="stat_payload_id" type="string"/>
    </bean>

    <bean name="AnimationStyle">
        <var name="style_id" type="string"/>
        <var name="motion_kind" type="string"/>
        <var name="duration_seconds" type="float"/>
        <var name="easing" type="AnimationEasing"/>
        <var name="flash_color" type="string"/>
        <var name="scale_feedback" type="float"/>
        <var name="instant" type="bool"/>
    </bean>

    <bean name="ActionPresentation">
        <var name="action_spec_id" type="string"/>
        <var name="fact_type" type="string"/>
    </bean>

    <table name="TbEntityArchetype" index="config_id" value="EntityArchetype" input="gamecore/entity_archetype.xlsx"/>
    <table name="TbWorldSpawn" mode="list" value="WorldSpawn" input="gamecore/world_spawn.xlsx"/>
    <table name="TbPlayerSpawnRule" index="rule_id" value="PlayerSpawnRule" input="gamecore/player_spawn_rule.xlsx"/>
    <table name="TbPortConnectorConfig" index="config_id" value="PortConnectorConfig" input="gamecore/port_connector_config.xlsx"/>
    <table name="TbPushOnEnterConfig" index="config_id" value="PushOnEnterConfig" input="gamecore/push_on_enter_config.xlsx"/>
    <table name="TbTargetFilterSpec" index="filter_id" value="TargetFilterSpec" input="*@gamecore/target_filter_spec.json"/>
    <table name="TbTargetingSpec" index="targeting_id" value="TargetingSpec" input="*@gamecore/targeting_spec.json"/>
    <table name="TbBlockedResultPolicy" index="policy_id" value="BlockedResultPolicy" input="*@gamecore/blocked_result_policy.json"/>
    <table name="TbBlockedResultBranch" mode="list" value="BlockedResultBranch" input="*@gamecore/blocked_result_branch.json"/>
    <table name="TbActionSpec" index="spec_id" value="ActionSpec" input="gamecore/action_spec.xlsx"/>
    <table name="TbEffectSpec" index="effect_id" value="EffectSpec" input="*@gamecore/effect_spec.json"/>
    <table name="TbAnimationStyle" index="style_id" value="AnimationStyle" input="*@gamecore/animation_style.json"/>
    <table name="TbActionPresentation" index="action_spec_id" value="ActionPresentation" input="*@gamecore/action_presentation.json"/>
</module>
