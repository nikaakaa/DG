<module name="gamecore">
    <enum name="ComponentKind">
        <var name="Position" value="1"/>
        <var name="Direction" value="2"/>
        <var name="Collider" value="3"/>
        <var name="Blocking" value="4"/>
        <var name="Bouncable" value="5"/>
        <var name="AutoMove" value="6"/>
        <var name="PlayerControl" value="7"/>
        <var name="PushOnEnter" value="8"/>
        <var name="Pushable" value="9"/>
        <var name="PortConnector" value="10"/>
    </enum>

    <enum name="EntityTarget">
        <var name="All" value="0"/>
        <var name="Player" value="1"/>
        <var name="Monster" value="2"/>
        <var name="Object" value="3"/>
    </enum>

    <enum name="Direction">
        <var name="None" value="0"/>
        <var name="Left" value="1"/>
        <var name="Right" value="2"/>
        <var name="Up" value="3"/>
        <var name="Down" value="4"/>
    </enum>

    <enum name="ActionPrimitive">
        <var name="Move" value="1"/>
        <var name="Spawn" value="2"/>
        <var name="Remove" value="3"/>
        <var name="SetComponentResult" value="4"/>
        <var name="ApplyRuntimeEffect" value="5"/>
    </enum>

    <enum name="ActionSourceKind">
        <var name="Player" value="1"/>
        <var name="Auto" value="2"/>
        <var name="Mechanism" value="3"/>
        <var name="Debug" value="4"/>
        <var name="Runtime" value="5"/>
        <var name="Handoff" value="6"/>
    </enum>

    <enum name="ActionPriority">
        <var name="Debug" value="1"/>
        <var name="Player" value="2"/>
        <var name="Mechanism" value="3"/>
        <var name="Auto" value="4"/>
    </enum>

    <enum name="ActionTargetRule">
        <var name="None" value="0"/>
        <var name="TargetCoordOneStep" value="1"/>
        <var name="TargetCoordAny" value="2"/>
        <var name="DirectionFromRequest" value="3"/>
        <var name="DirectionFromComponent" value="4"/>
    </enum>

    <enum name="ActionBlockedPolicy">
        <var name="Reject" value="1"/>
        <var name="StartPushIfPushable" value="2"/>
        <var name="BounceIfBouncable" value="3"/>
    </enum>

    <enum name="ActionHandoffPolicy">
        <var name="None" value="0"/>
        <var name="Configured" value="1"/>
    </enum>

    <enum name="ActionConflictPolicy">
        <var name="None" value="0"/>
        <var name="ExclusiveTargetCell" value="1"/>
    </enum>

    <enum name="ActionInterruptPolicy">
        <var name="None" value="0"/>
        <var name="HigherPriorityInterruptsLower" value="1"/>
    </enum>

    <enum name="ActionMergePolicy">
        <var name="None" value="0"/>
        <var name="SameClaim" value="1"/>
    </enum>

    <enum name="ActionSubjectPolicy">
        <var name="HitEntity" value="1"/>
        <var name="ConnectedBodyIfAny" value="2"/>
    </enum>

    <enum name="ActionPlanRule">
        <var name="None" value="0"/>
        <var name="MoveBody" value="1"/>
        <var name="SpawnEntity" value="2"/>
        <var name="RemoveEntity" value="3"/>
    </enum>

    <enum name="ActionCommitRule">
        <var name="None" value="0"/>
        <var name="SetAutoMoveTick" value="1"/>
        <var name="SetDirectionOnBounce" value="2"/>
    </enum>

    <enum name="AnimationEasing">
        <var name="Linear" value="1"/>
        <var name="EaseOut" value="2"/>
        <var name="EaseInOut" value="3"/>
    </enum>

    <bean name="EntityArchetype">
        <var name="config_id" type="int"/>
        <var name="archetype_id" type="int"/>
        <var name="entity_target" type="EntityTarget"/>
        <var name="components" type="(list#sep=,),ComponentKind"/>
        <var name="tags" type="(list#sep=,),string"/>
        <var name="default_auto_move_interval_ticks" type="int"/>
    </bean>

    <bean name="WorldSpawn">
        <var name="world_id" type="string"/>
        <var name="entity_id" type="long"/>
        <var name="config_id" type="int"/>
        <var name="x" type="int"/>
        <var name="y" type="int"/>
        <var name="direction" type="Direction"/>
        <var name="auto_move_interval_ticks" type="int"/>
    </bean>

    <bean name="PlayerSpawnRule">
        <var name="rule_id" type="string"/>
        <var name="player_config_id" type="int"/>
        <var name="start_x" type="int"/>
        <var name="start_y" type="int"/>
        <var name="step_x" type="int"/>
        <var name="step_y" type="int"/>
        <var name="max_attempts" type="int"/>
    </bean>

    <bean name="PortConnectorConfig">
        <var name="config_id" type="int"/>
        <var name="ports" type="int"/>
    </bean>

    <bean name="PushOnEnterConfig">
        <var name="config_id" type="int"/>
        <var name="output_spec_id" type="string"/>
        <var name="output_cost_ticks" type="int"/>
    </bean>

    <bean name="ActionSpec">
        <var name="spec_id" type="string"/>
        <var name="primitive" type="ActionPrimitive"/>
        <var name="source" type="ActionSourceKind"/>
        <var name="priority" type="ActionPriority"/>
        <var name="source_tag" type="string"/>
        <var name="ability_tag" type="string"/>
        <var name="required_tags" type="(list#sep=,),string"/>
        <var name="blocked_tags" type="(list#sep=,),string"/>
        <var name="target_rule" type="ActionTargetRule"/>
        <var name="blocked_policy" type="ActionBlockedPolicy"/>
        <var name="handoff_policy" type="ActionHandoffPolicy"/>
        <var name="handoff_spec_id" type="string"/>
        <var name="handoff_subject_policy" type="ActionSubjectPolicy"/>
        <var name="max_chain_depth" type="int"/>
        <var name="conflict_policy" type="ActionConflictPolicy"/>
        <var name="interrupt_policy" type="ActionInterruptPolicy"/>
        <var name="merge_policy" type="ActionMergePolicy"/>
        <var name="subject_policy" type="ActionSubjectPolicy"/>
        <var name="plan_rule" type="ActionPlanRule"/>
        <var name="commit_rules" type="(list#sep=,),ActionCommitRule"/>
        <var name="default_cost_ticks" type="int"/>
    </bean>

    <bean name="AnimationStyle">
        <var name="style_id" type="string"/>
        <var name="motion_kind" type="string"/>
        <var name="duration_seconds" type="float"/>
        <var name="easing" type="AnimationEasing"/>
        <var name="flash_color" type="string"/>
        <var name="scale_feedback" type="float"/>
        <var name="instant" type="bool"/>
    </bean>

    <table name="TbEntityArchetype" index="config_id" value="EntityArchetype" input="gamecore/entity_archetype.xlsx"/>
    <table name="TbWorldSpawn" mode="list" value="WorldSpawn" input="gamecore/world_spawn.xlsx"/>
    <table name="TbPlayerSpawnRule" index="rule_id" value="PlayerSpawnRule" input="gamecore/player_spawn_rule.xlsx"/>
    <table name="TbPortConnectorConfig" index="config_id" value="PortConnectorConfig" input="gamecore/port_connector_config.xlsx"/>
    <table name="TbPushOnEnterConfig" index="config_id" value="PushOnEnterConfig" input="gamecore/push_on_enter_config.xlsx"/>
    <table name="TbActionSpec" index="spec_id" value="ActionSpec" input="gamecore/action_spec.xlsx"/>
    <table name="TbAnimationStyle" index="style_id" value="AnimationStyle" input="*@gamecore/animation_style.json"/>
</module>
